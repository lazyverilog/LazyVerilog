  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "One thread reads and dispatches, so an edit lands before anything queued behind it",
        "foldingRange and inlayHint run on a 2-worker pool so they never block completion",
        "A request arriving mid-parse is answered from the previous snapshot, not with nothing"
      ]
    },
    {
      "dot": "emerald",
      "title": "Index model",
      "items": [
        "Current file: live slang AST. Closed project files: compact index shards",
        "One union index; a duplicated module name is ranked by path proximity, never filtered",
        "Shards persist per project, keyed on content digests rather than mtime"
      ]
    },
    {
      "dot": "violet",
      "title": "Project model",
      "items": [
        "The server resolves each file to its nearest lazyverilog.toml; the editor sends no root",
        "Defines and +incdir+ are per file, against a single Analyzer",
        "Compilation is per project; its diagnostics return via the Analyzer cache"
      ]
    }
  ]
