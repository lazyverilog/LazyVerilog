{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["begin", "end"],
    ["fork", "join"],
    ["fork", "join_any"],
    ["fork", "join_none"],
    ["case", "endcase"],
    ["casex", "endcase"],
    ["casez", "endcase"],
    ["randcase", "endcase"],
    ["module", "endmodule"],
    ["macromodule", "endmodule"],
    ["interface", "endinterface"],
    ["program", "endprogram"],
    ["package", "endpackage"],
    ["class", "endclass"],
    ["function", "endfunction"],
    ["task", "endtask"],
    ["generate", "endgenerate"],
    ["specify", "endspecify"],
    ["primitive", "endprimitive"],
    ["table", "endtable"],
    ["config", "endconfig"],
    ["clocking", "endclocking"],
    ["covergroup", "endgroup"],
    ["property", "endproperty"],
    ["sequence", "endsequence"],
    ["randsequence", "endsequence"],
    ["checker", "endchecker"],
    ["`ifdef", "`endif"],
    ["`ifndef", "`endif"],
    ["`celldefine", "`endcelldefine"],
    ["`begin_keywords", "`end_keywords"],
    ["`uvm_object_utils_begin", "`uvm_object_utils_end"],
    ["`uvm_object_param_utils_begin", "`uvm_object_utils_end"],
    ["`uvm_object_abstract_utils_begin", "`uvm_object_utils_end"],
    ["`uvm_object_abstract_param_utils_begin", "`uvm_object_utils_end"],
    ["`uvm_component_utils_begin", "`uvm_component_utils_end"],
    ["`uvm_component_param_utils_begin", "`uvm_component_utils_end"],
    ["`uvm_component_abstract_utils_begin", "`uvm_component_utils_end"],
    ["`uvm_component_abstract_param_utils_begin", "`uvm_component_utils_end"],
    ["`uvm_field_utils_begin", "`uvm_field_utils_end"],
    ["`uvm_info_begin", "`uvm_info_end"],
    ["`uvm_warning_begin", "`uvm_warning_end"],
    ["`uvm_error_begin", "`uvm_error_end"],
    ["`uvm_fatal_begin", "`uvm_fatal_end"],
    ["`uvm_info_context_begin", "`uvm_info_context_end"],
    ["`uvm_warning_context_begin", "`uvm_warning_context_end"],
    ["`uvm_error_context_begin", "`uvm_error_context_end"],
    ["`uvm_fatal_context_begin", "`uvm_fatal_context_end"],
    ["`uvm_message_begin", "`uvm_message_end"],
    ["`uvm_message_context_begin", "`uvm_message_context_end"]
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ]
}
