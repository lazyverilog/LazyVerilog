// lazyverilog patch: a macro whose argument list runs to the end of the input
// is expanded after the last lexer has been popped, so lexerStack.back() reads
// before the vector.  Stringification only needs a lexer's allocator, source
// manager and options; lend it an empty one when the stack has none.
static Lexer& lazyverilogStringifyLexer(SmallVectorBase<std::unique_ptr<Lexer>>& stack,
                                        BumpAllocator& alloc, Diagnostics& diagnostics,
                                        SourceManager& sourceManager,
                                        const LexerOptions& options) {
    if (!stack.empty())
        return *stack.back();
    // A pointer, not a thread_local std::optional<Lexer>: MinGW's emulated TLS
    // frees a thread's storage before its thread_local destructors run, so the
    // Lexer was destroyed from freed memory whenever a parse thread exited.
    // At most one Lexer per thread outlives it.
    thread_local Lexer* empty = nullptr;
    delete empty;
    empty = new Lexer(SourceBuffer{std::string_view("", 1), nullptr, BufferID::getPlaceholder()},
                      alloc, diagnostics, sourceManager, options);
    return *empty;
}

